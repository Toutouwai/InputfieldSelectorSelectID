<?php namespace ProcessWire;

class InputfieldSelectorSelectID extends WireData implements Module {

	/**
	 * Module information
	 */
	public static function getModuleInfo() {
		return array(
			'title' => 'Inputfield Selector Select ID',
			'summary' => 'Uses the Page List Select inputfield for user-friendly input of page IDs into Inputfield Selector.',
			'version' => '0.1.1',
			'author' => 'Robin Sallis',
			'href' => 'https://github.com/Toutouwai/InputfieldSelectorSelectID',
			'icon' => 'bolt',
			'autoload' => 'template=admin',
			'requires' => 'ProcessWire>=3.0.0, PHP>=5.4.0',
		);
	}

	/**
	 * Ready
	 */
	public function ready() {
		$this->addHookAfter('InputfieldSelector::renderReadyHook', $this, 'afterRenderReady');
		$this->addHookAfter('InputfieldSelector::render', $this, 'afterRender');
	}

	/**
	 * After InputfieldSelector::renderReadyHook
	 * Load assets
	 *
	 * @param HookEvent $event
	 */
	protected function afterRenderReady(HookEvent $event) {
		// Ensure Page List Select assets are loaded
		$f = $event->wire('modules')->get('InputfieldPageListSelect');
		$f->renderReady();

		// Use Vex
		$this->wire('modules')->get('JqueryUI')->use('vex');

		// Add module CSS and JS
		$config = $this->wire('config');
		$info = $this->getModuleInfo();
		$version = $info['version'];
		$config->styles->add($config->urls->$this . "{$this}.css?v=$version");
		$config->scripts->add($config->urls->$this . "{$this}.js?v=$version");
	}

	/**
	 * After InputfieldSelector::render
	 * Add markup
	 *
	 * @param HookEvent $event
	 */
	protected function afterRender(HookEvent $event) {
		$inputfieldSelector = $event->object;
		$out = $event->return;

		// Return early if not allowed for this instance of InputfieldSelector
		if(!$this->enableModule($inputfieldSelector)) return;

		// Get PageListSelect
		/** @var InputfieldPageListSelect $pls */
		$pls = $this->getPageListSelect($inputfieldSelector);
		$pls->name = '_issi_select';
		$plsRender = $pls->render();

		// Translatable strings
		$buttonTitle = $this->_('Select a page ID visually');
		$heading = $this->_('Select a page');

		// Add markup
		$out .= <<<EOT
<button type="button" class="issi-open" title="$buttonTitle"><i class="fa fa-fw fa-bolt"></i></button>
<script type="text/html" class="issi-template">
<h3 class="issi-head">$heading</h3>
<div class="InputfieldContent">
	<div class="InputfieldPageListSelect">
		$plsRender
	</div>
</div>
</script>
EOT;
		$event->return = $out;
	}

	/**
	 * Hookable method to determine whether InputfieldSelectorSelectID is allowed for
	 * the given instance of InputfieldSelector
	 *
	 * @param InputfieldPageListSelect $inputfieldSelector
	 * @return bool
	 */
	protected function ___enableModule(InputfieldSelector $inputfieldSelector) {
		return true;
	}

	/**
	 * Hookable method to get InputfieldPageListSelect
	 *
	 * @param InputfieldPageListSelect $inputfieldSelector
	 * @return InputfieldPageListSelect
	 */
	protected function ___getPageListSelect(InputfieldSelector $inputfieldSelector) {
		/** @var InputfieldPageListSelect $pls */
		$pls = $this->wire()->modules->get('InputfieldPageListSelect');
		return $pls;
	}

}
